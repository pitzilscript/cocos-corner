---
const { active } = Astro.props
---

<nav class="fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-6 py-4 bg-[var(--color-cream)]/90 backdrop-blur-sm border-b border-[var(--color-slate-light)]">
  <a href="/" class="flex items-center gap-3">
    <div class="h-10 w-10 rounded-full overflow-hidden shrink-0">
      <img src="/logo.png" alt="Coco's Corner" class="w-full h-full object-cover scale-[1.18]" />
    </div>
    <div>
      <div class="font-serif font-bold text-[var(--color-chocolate)] leading-tight">Coco's Corner</div>
      <div class="text-[10px] tracking-widest text-[var(--color-slate)] uppercase">Farmstand & Bakery</div>
    </div>
  </a>
  <div class="flex gap-6 text-sm font-medium">
    <a
      href="/menu"
      class={`nav-link transition-colors ${active === 'menu' ? 'text-[var(--color-slate-dark)]' : 'text-[var(--color-chocolate-light)] hover:text-[var(--color-slate-dark)]'}`}
    >Menu</a>
    <a
      href="/instagram"
      class={`nav-link transition-colors ${active === 'instagram' ? 'text-[var(--color-slate-dark)]' : 'text-[var(--color-chocolate-light)] hover:text-[var(--color-slate-dark)]'}`}
    >Instagram</a>
    <a
      href="/order"
      class={`nav-link transition-colors ${active === 'order' ? 'text-[var(--color-slate-dark)]' : 'text-[var(--color-chocolate-light)] hover:text-[var(--color-slate-dark)]'}`}
    >Order</a>
  </div>
</nav>
