---
import Layout from "../layouts/Layout.astro"
import Nav from "../components/Nav.astro"
import { farmstand } from "../data/menu"
---

<Layout>
  <Nav />

  <!-- Hero -->
  <section class="relative min-h-screen flex flex-col items-center justify-center text-center px-6 pt-20 overflow-hidden">
    <!-- Background photo -->
    <img
      src="/mmalcom1-cookie-4652159.jpg"
      alt=""
      class="hero-bg absolute inset-0 w-full h-full object-cover grayscale blur-[1px]"
      aria-hidden="true"
    />
    <!-- Overlay -->
    <div class="absolute inset-0" style="background: rgba(242, 237, 227, 0.82);"></div>

    <div class="relative max-w-2xl mx-auto">
      <div class="hero-logo h-56 w-56 rounded-full overflow-hidden mx-auto mb-8 opacity-90">
        <img src="/logo.png" alt="" class="w-full h-full object-cover scale-[1.18]" style="object-position: 52% 48%;" />
      </div>
      <p class="hero-label text-xs tracking-[0.3em] text-[var(--color-slate)] uppercase mb-4">Farmstand & Bakery</p>
      <h1 class="hero-title font-serif text-7xl md:text-8xl font-bold text-[var(--color-chocolate)] leading-none mb-6">
        Coco's<br />Corner
      </h1>
      <div class="hero-divider w-12 h-px bg-[var(--color-slate-light)] mx-auto mb-6"></div>
      <p class="hero-tagline font-serif italic text-xl text-[var(--color-chocolate-light)] leading-relaxed mb-10">
        Baked fresh. Grown with care.<br />Found right here in the neighborhood.
      </p>
      <div class="hero-cta">
        {farmstand.formOpen ? (
          <a
            href={farmstand.formUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-lift inline-block bg-[var(--color-chocolate)] text-[var(--color-ivory)] px-8 py-4 rounded-full font-medium text-sm tracking-wide hover:bg-[var(--color-chocolate-light)] transition-colors"
          >
            Order Now
          </a>
        ) : (
          <p class="text-sm text-[var(--color-slate)] tracking-wide">
            Next farmstand: <span class="font-medium text-[var(--color-chocolate)]">{farmstand.date}</span>
          </p>
        )}
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="py-24 px-6 bg-[var(--color-slate-muted)]">
    <div class="max-w-2xl mx-auto text-center reveal">
      <p class="text-xs tracking-[0.3em] text-[var(--color-slate)] uppercase mb-4">About</p>
      <h2 class="font-serif text-4xl font-bold text-[var(--color-chocolate)] mb-6">Made with love,<br />sold at the stand</h2>
      <p class="text-[var(--color-chocolate-light)] leading-relaxed text-lg mb-10">
        Every item at Coco's Corner is homemade and baked fresh the night before the farmstand.
        We show up once a month with cookies, cake, and bread — and we sell until it's gone.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/menu" class="inline-block bg-[var(--color-slate)] text-white px-8 py-3 rounded-full text-sm font-medium hover:bg-[var(--color-slate-dark)] transition-colors">
          See This Month's Menu
        </a>
        <a href="/order" class="inline-block border border-[var(--color-slate)] text-[var(--color-slate-dark)] px-8 py-3 rounded-full text-sm font-medium hover:bg-[var(--color-slate-light)] transition-colors">
          Place an Order
        </a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="py-8 px-6 border-t border-[var(--color-slate-light)] bg-[var(--color-cream)]">
    <div class="max-w-2xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-[var(--color-slate)]">
      <span class="font-serif text-[var(--color-chocolate)]">Coco's Corner</span>
      <span>Farmstand & Bakery · {new Date().getFullYear()}</span>
    </div>
  </footer>
</Layout>
